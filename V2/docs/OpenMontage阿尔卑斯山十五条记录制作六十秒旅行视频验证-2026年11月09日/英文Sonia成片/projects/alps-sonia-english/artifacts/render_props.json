  "captions": {
    "words": [
      {
        "word": "I left before dawn",
        "startMs": 150,
        "endMs": 1509
      },
      {
        "word": "wondering why I'd dragged myself out into the cold.",
        "startMs": 1509,
        "endMs": 5358
      },
      {
        "word": "Then the first light caught the peaks.",
        "startMs": 7150,
        "endMs": 9950
      },
      {
        "word": "Some moments just don't fit inside a photograph.",
        "startMs": 9950,
        "endMs": 13486
      },
      {
        "word": "But the trail got rough.",
        "startMs": 14150,
        "endMs": 16314
      },
      {
        "word": "My legs ached.",
        "startMs": 16314,
        "endMs": 17576
      },
      {
        "word": "For a while",
        "startMs": 17576,
        "endMs": 18568
      },
      {
        "word": "I really wanted to turn back.",
        "startMs": 18568,
        "endMs": 21182
      },
      {
        "word": "An old man on the path told me",
        "startMs": 22150,
        "endMs": 24581
      },
      {
        "word": "'Don't rush to the top.",
        "startMs": 24581,
        "endMs": 26445
      },
      {
        "word": "Take your time.'",
        "startMs": 26445,
        "endMs": 27742
      },
      {
        "word": "So I put my phone away.",
        "startMs": 30150,
        "endMs": 32529
      },
      {
        "word": "Cowbells",
        "startMs": 32529,
        "endMs": 33356
      },
      {
        "word": "wind",
        "startMs": 33356,
        "endMs": 33770
      },
      {
        "word": "bread and cheese.",
        "startMs": 33770,
        "endMs": 35528
      },
      {
        "word": "Somehow",
        "startMs": 35528,
        "endMs": 36252
      },
      {
        "word": "it was enough.",
        "startMs": 36252,
        "endMs": 37700
      },
      {
        "word": "Then the clouds lifted.",
        "startMs": 38150,
        "endMs": 40079
      },
      {
        "word": "The whole valley opened up.",
        "startMs": 40079,
        "endMs": 42343
      },
      {
        "word": "I just stood there",
        "startMs": 42343,
        "endMs": 43852
      },
      {
        "word": "saying nothing.",
        "startMs": 43852,
        "endMs": 45110
      },
      {
        "word": "The hard part passed.",
        "startMs": 46150,
        "endMs": 47841
      },
      {
        "word": "From up here",
        "startMs": 47841,
        "endMs": 48807
      },
      {
        "word": "the things I'd worried about felt so small.",
        "startMs": 48807,
        "endMs": 52270
      },
      {
        "word": "By dusk",
        "startMs": 53150,
        "endMs": 53747
      },
      {
        "word": "the village lights felt like home.",
        "startMs": 53747,
        "endMs": 56649
      },
      {
        "word": "What I'd found was my own pace.",
        "startMs": 56649,
        "endMs": 59294
      }
    ],
