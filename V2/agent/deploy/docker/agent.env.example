# Copy to agent.env and fill locally; never commit the filled file.
# Docker env-file uses literal values: do not add quotes or ${VAR} placeholders.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SPUR_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
SPUR_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
SPUR_VIDEO_T2V_MODEL=Wan-AI/Wan2.2-T2V-A14B
# Optional; leave empty if email is not being tested.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Optional Notion internal integration token. Read-only. Never commit a real value.
NOTION_TOKEN=
