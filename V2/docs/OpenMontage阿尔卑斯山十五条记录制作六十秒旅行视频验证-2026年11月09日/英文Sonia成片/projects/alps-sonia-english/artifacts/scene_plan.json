    "recording_to_narration": [
      {
        "id": "1",
        "duration_seconds": 7,
        "narration": "天还没亮，我就出发了。冷得有点后悔，却又期待着什么。",
        "recording_ids": [
          1
        ],
        "emotion": "dawn"
      },
      {
        "id": "2",
        "duration_seconds": 7,
        "narration": "直到第一束光，把雪山染成金色。照片装不下那一刻。",
        "recording_ids": [
          2
        ],
        "emotion": "sunrise"
      },
      {
        "id": "3",
        "duration_seconds": 8,
        "narration": "可碎石路越走越难，腿越来越酸。我第一次想，要不算了。",
        "recording_ids": [
          3,
          6
        ],
        "emotion": "fatigue"
      },
      {
        "id": "4",
        "duration_seconds": 8,
        "narration": "路上，一位走了三十年的老人说：别急着到山顶，慢慢走。",
        "recording_ids": [
          5
        ],
        "emotion": "turning"
      },
      {
        "id": "5",
        "duration_seconds": 8,
        "narration": "我收起手机，听风，听牛铃。一块面包，也吃得格外满足。",
        "recording_ids": [
          4,
          8,
          9
        ],
        "emotion": "calm"
      },
      {
        "id": "6",
        "duration_seconds": 8,
        "narration": "后来，云突然散了。山谷整个出现在眼前。我站了很久。",
        "recording_ids": [
          7,
          10
        ],
        "emotion": "reveal"
      },
      {
        "id": "7",
        "duration_seconds": 7,
        "narration": "原来，有些疲惫，不必急着战胜。走过这一段，就会不一样。",
        "recording_ids": [
          11,
          12
        ],
        "emotion": "release"
      },
      {
        "id": "8",
        "duration_seconds": 7,
        "narration": "下山时，小镇亮起了灯。今天找回的，不是高度，是自己的节奏。",
        "recording_ids": [
          13,
          14,
          15
        ],
        "emotion": "home"
      }
    ],
    "english_script": [
      {
        "id": 0,
        "narration": "I left before dawn, wondering why I'd dragged myself out into the cold.",
        "duration": 7,
        "original_tts_seconds": 5.208,
        "speed_factor": 1,
        "path": "/Users/x/X/space/spur/V2/docs/OpenMontage阿尔卑斯山十五条记录制作六十秒旅行视频验证-2026年11月09日/英文Sonia成片/audio/0.wav",
        "recording_ids": [
          1
        ]
      },
      {
        "id": 1,
        "narration": "Then the first light caught the peaks. Some moments just don't fit inside a photograph.",
        "duration": 7,
        "original_tts_seconds": 6.336,
        "speed_factor": 1,
        "path": "/Users/x/X/space/spur/V2/docs/OpenMontage阿尔卑斯山十五条记录制作六十秒旅行视频验证-2026年11月09日/英文Sonia成片/audio/1.wav",
        "recording_ids": [
          2
        ]
      },
      {
        "id": 2,
        "narration": "But the trail got rough. My legs ached. For a while, I really wanted to turn back.",
        "duration": 8,
        "original_tts_seconds": 7.032,
        "speed_factor": 1,
        "path": "/Users/x/X/space/spur/V2/docs/OpenMontage阿尔卑斯山十五条记录制作六十秒旅行视频验证-2026年11月09日/英文Sonia成片/audio/2.wav",
        "recording_ids": [
          3,
          6
        ]
      },
      {
        "id": 3,
        "narration": "An old man on the path told me, 'Don't rush to the top. Take your time.'",
        "duration": 8,
        "original_tts_seconds": 5.592,
        "speed_factor": 1,
        "path": "/Users/x/X/space/spur/V2/docs/OpenMontage阿尔卑斯山十五条记录制作六十秒旅行视频验证-2026年11月09日/英文Sonia成片/audio/3.wav",
        "recording_ids": [
          5
        ]
      },
      {
        "id": 4,
        "narration": "So I put my phone away. Cowbells, wind... bread and cheese. Somehow, it was enough.",
        "duration": 8,
        "original_tts_seconds": 7.728,
        "speed_factor": 1.0235761589403973,
        "path": "/Users/x/X/space/spur/V2/docs/OpenMontage阿尔卑斯山十五条记录制作六十秒旅行视频验证-2026年11月09日/英文Sonia成片/audio/4.wav",
        "recording_ids": [
          4,
          8,
          9
        ]
      },
      {
        "id": 5,
        "narration": "Then the clouds lifted. The whole valley opened up. I just stood there, saying nothing.",
        "duration": 8,
        "original_tts_seconds": 6.96,
        "speed_factor": 1,
        "path": "/Users/x/X/space/spur/V2/docs/OpenMontage阿尔卑斯山十五条记录制作六十秒旅行视频验证-2026年11月09日/英文Sonia成片/audio/5.wav",
        "recording_ids": [
          7,
          10
        ]
      },
      {
        "id": 6,
        "narration": "The hard part passed. From up here, the things I'd worried about felt so small.",
        "duration": 7,
        "original_tts_seconds": 6.12,
        "speed_factor": 1,
        "path": "/Users/x/X/space/spur/V2/docs/OpenMontage阿尔卑斯山十五条记录制作六十秒旅行视频验证-2026年11月09日/英文Sonia成片/audio/6.wav",
        "recording_ids": [
          11,
          12
        ]
      },
      {
        "id": 7,
        "narration": "By dusk, the village lights felt like home. What I'd found was my own pace.",
        "duration": 7,
        "original_tts_seconds": 6.144,
        "speed_factor": 1,
        "path": "/Users/x/X/space/spur/V2/docs/OpenMontage阿尔卑斯山十五条记录制作六十秒旅行视频验证-2026年11月09日/英文Sonia成片/audio/7.wav",
        "recording_ids": [
          13,
